{
  "$id": "https://github.com/alias8818/enoch-promising-signals/schemas/promising-signal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_scope": {
      "minLength": 1,
      "type": "string"
    },
    "decision_summary": {
      "minLength": 1,
      "type": "string"
    },
    "do_not_overclaim": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "evidence_strength": {
      "minLength": 1,
      "type": "string"
    },
    "followup": {
      "type": "object"
    },
    "hypothesis_status": {
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "type": "string"
    },
    "recommended_next_action": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "scale_limits": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "enoch_promising_signal_v1"
    },
    "sources": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "compute_scale_blocked",
        "promising_if_scaled",
        "useful_signal"
      ]
    },
    "stop_reason": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "useful_signal_summary": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "title",
    "status",
    "decision_summary",
    "hypothesis_status",
    "evidence_strength",
    "claim_scope",
    "scale_limits",
    "useful_signal_summary",
    "stop_reason",
    "recommended_next_action",
    "sources",
    "followup",
    "evidence",
    "do_not_overclaim"
  ],
  "title": "Enoch Promising Signal",
  "type": "object"
}
